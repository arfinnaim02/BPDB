# Server-only configuration. Never use NEXT_PUBLIC_ for these values.
BACKEND_URL=http://127.0.0.1:8000
# Must equal ADMIN_API_KEY configured on the Python backend.
BACKEND_API_KEY=
# Workspace sign-in password: use a unique long random value (minimum 12 characters).
DASHBOARD_PASSWORD=
# Random session signing secret: at least 32 characters. Generate with crypto.randomBytes.
SESSION_SECRET=
